# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋되지 않는다.
#
# DATABASE_URL 이 비어 있으면 기존 SQLite(demo/out/demo.db)로 자동 폴백한다.
# Supabase 는 Settings -> Database -> Connection string 에서 복사한다.
#   반드시 Session pooler / Transaction pooler 문자열을 쓸 것.
#   Direct connection(db.xxx.supabase.co:5432)은 무료 티어에서 IPv6 전용이라
#   GitHub Actions 러너(IPv4)에서 연결이 안 된다.
#
# 예) postgresql://postgres.abcdefghijk:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# 비밀번호에 특수문자가 있어도 원문 그대로 넣으면 된다(퍼센트 인코딩도 동작).
DATABASE_URL=

# 작업 가이드는 코드가 시간·점수를 확정하고 Gemini는 설명만 생성한다.
# 키가 비어 있으면 동일한 확정 계획을 LLM 없이 출력한다.
GOOGLE_API_KEY=

# ★ gemini-3.5-flash 는 하루 요청 한도(RPD)가 20 이라 시연 중 소진된다.
#   gemini-3.5-flash-lite 는 RPD 500 으로 실사용이 확인됐다(rag_yujin/.env.example).
GEMINI_MODEL_NAME=gemini-3.5-flash-lite

# current main의 risk_hourly와 PR #9 RAG를 쓰는 데모 모드.
# 구조 검증용 고정 데이터만 볼 때는 fixture로 바꾼다.
D_PROVIDER_MODE=legacy

# ── RAG 벡터 백엔드 ────────────────────────────────────────────────
# pgvector : Supabase 의 rag 스키마를 쓴다. 배포·GitHub Actions·팀 공유용.
#            먼저 `python rag_yujin/_4b_migrate_to_pg.py` 로 적재해야 한다.
# chroma   : 로컬 rag_yujin/data/chroma_db 를 쓴다. 오프라인 개발용.
#            먼저 `python rag_yujin/_4_database.py` 로 만들어야 한다.
# auto     : DATABASE_URL 이 있으면 pgvector, 없으면 chroma (미지정 시 기본값)
RAG_BACKEND=pgvector

# 로컬 Docker 로 테스트할 때 (docker run -p 55432:5432 postgres:16-alpine)
# DATABASE_URL=postgresql://postgres:devpass@localhost:55432/slai

# ── 사이드바 「내 위치」 ────────────────────────────────────────────
# 선택 — 주소 검색(VWORLD 지오코딩)에만 쓴다. 없으면 주소 검색만 비활성화되고
# 지도 클릭·GPS 는 그대로 동작한다.
#
# ⚠️ KMA_KEY 는 여전히 설정하지 말 것 (serving/kma_midterm.py 의 이중 인코딩 문제).
VWORLD_KEY=
