# 이 파일을 복사해서 .env로 저장한 뒤 실제 값을 채워 넣으세요.
#   cp .env.example .env
# .env 파일 자체는 git에 커밋하지 않습니다(.gitignore에서 제외).

# Google AI Studio에서 발급받은 Gemini API 키
GOOGLE_API_KEY=

# 사용할 Gemini 모델명.
# gemini-3.5-flash는 하루 요청 한도(RPD)가 20으로 매우 낮아 금방 소진됩니다.
# gemini-3.5-flash-lite는 RPD 500으로 실제 테스트에서 문제없이 동작을 확인했으므로
# 기본값으로 이 모델을 권장합니다.
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
