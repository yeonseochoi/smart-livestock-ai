# Streamlit Cloud 대시보드의 Settings -> Secrets 에 아래 내용을 붙여넣는다.
# 이 파일 자체는 예시이며, 실제 secrets.toml 은 .gitignore 대상이다.

DATABASE_URL = "postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"
GOOGLE_API_KEY = "..."
GEMINI_MODEL_NAME = "gemini-3.5-flash-lite"
D_PROVIDER_MODE = "legacy"
RAG_BACKEND = "pgvector"

# 선택 — 사이드바 「내 위치」의 주소 검색(VWORLD 지오코딩)에만 쓴다.
# 없으면 주소 검색만 비활성화되고 지도 클릭·GPS 는 그대로 동작한다.
VWORLD_KEY = "..."
